# Notion — create an internal integration at https://www.notion.so/my-integrations,
# then share the "Unix — Social Studio" page with it (••• → Connections).
NOTION_TOKEN=ntn_xxx
NOTION_POSTS_DB=19e0d315db6f4c98a27b58502235b51e

# Postiz — your self-hosted instance (Settings → Public API → API key)
POSTIZ_URL=https://postiz.unixcreativestudio.com
POSTIZ_API_KEY=xxx

# Optional
CHECK_EVERY_MINUTES=10
VIDEO_FPS=30
# Until your TikTok app is audited, TikTok only allows private posts: use SELF_ONLY
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
# Force a specific Postiz channel id per platform (otherwise found automatically)
# POSTIZ_INTEGRATION_INSTAGRAM=
# POSTIZ_INTEGRATION_TIKTOK=
# POSTIZ_INTEGRATION_LINKEDIN=
